					style="fill: rgb(255, 255, 255);"></path></svg
			>

			<p class="description">
				Fotografía, video y estrategias de contenido que convierten
				seguidores en clientes.
			</p>
			<div class="buttons">
				<a href="#" class="btn-primary"> Contactanos </a>
				<a href="#" class="btn-secondary">
					<span>Ver </span>Planes
				</a>
			</div>
		</div>
	</section>

	<section class="servicios" id="servicios">
		<div class="shape"></div>
		<div class="servicios-container">
			<div class="servicios-header" data-reveal>
				<div class="chip light">SERVICIOS</div>
				<h2>ACTUALIZAMOS <br /> TU <em>PERFÍL</em></h2>
			</div>
			<div class="servicios-cards">
				<div class="s-card sc1">
					<h3>Creación de contenido</h3>
					<div class="s-icon si1">
						<svg
							width="38"
							height="41"
							viewBox="0 0 38 41"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M18.4983 39.3962C16.9901 41.6073 14.9648 41.3746 13.9981 38.8786L0.314193 3.55099C-0.6525 1.05502 0.687429 -0.48148 3.29166 0.136809L34.6897 7.59162C37.294 8.20991 38.1906 10.5251 36.6824 12.7363L18.4983 39.3962Z"
								fill="white"></path>
						</svg>
					</div>
					<p>
						Si se trata de comida, nadie nos gana. Realizamos
						contenido creativo que <em>
							antoje, conecte y venda.</em
						>
					</p>
				</div>

				<div class="s-card sc2">
					<h3>Colaboraciones</h3>
					<div class="s-icon si2">
						<svg
							width="70"
							height="64"
							viewBox="0 0 70 64"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M69.1065 16.6132L41.9382 -5.67171e-06L42.6556 9.94561C-0.624402 15.7637 0.000496476 63.5295 0.000496476 63.5295C5.88076 37.4396 34.2629 29.4759 43.9164 27.4409L44.6029 36.9501L69.1065 16.6132Z"
								fill="white"></path>
						</svg>
					</div>
					<p>
						Conectamos marcas con creadores de contenido
						estrategiccos y asi <em>amplificar el alcance.</em>
					</p>
				</div>

				<div class="s-card sc3">
					<h3>Manejo de redes</h3>
					<div class="s-icon si3">
						<svg
							width="69"
							height="66"
							viewBox="0 0 69 66"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M66.8401 26.6764L66.7926 26.3059C66.5058 24.0655 64.7206 22.4308 62.8254 22.6734L54.8632 23.6924L47.3554 24.6535L46.337 24.7839C46.6604 7.28434 41.6211 1.1108 37.8837 2.67058C35.3621 3.72311 36.2351 6.88702 36.5803 9.58422C36.9256 12.2814 37.1428 18.7465 30.4031 22.3504C23.6632 25.9545 23.7684 28.6824 23.7684 28.6824L27.5477 58.2095C28.7225 61.6663 34.1262 60.9744 34.1262 60.9744L43.8399 59.7311L46.2549 59.422L59.31 57.7512C61.2052 57.5086 62.5212 55.477 62.2346 53.2367L62.1871 52.8663C61.9003 50.6257 60.1151 48.9912 58.2199 49.2338L61.1734 48.8557C63.0687 48.6132 64.3847 46.5816 64.0978 44.341L64.0504 43.9707C63.7635 41.7301 61.9784 40.0956 60.0832 40.3382L62.5445 40.0231C64.4397 39.7805 65.7557 37.749 65.4688 35.5086L65.4214 35.1381C65.1345 32.8977 63.3494 31.2632 61.4542 31.5058L63.9155 31.1907C65.8107 30.9486 67.1267 28.917 66.8401 26.6764Z"
								fill="white"></path>
							<path
								d="M18.6335 29.3027L2.05579 31.424L5.87026 61.2338L22.448 59.1125L18.6335 29.3027Z"
								fill="white"></path>
						</svg>
					</div>
					<p>
						¿Quieres mejorar la interacción y rendimiento de tus
						redes? ofrecemos <em>gestión estratégica</em> y diseño gráfico.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="objetivo">
		<div class="objetivo-container">
			<div class="objetivo-texts">

			
				<div class="objetivo-header" data-reveal>
					<div class="chip dark">OBJETIVO</div>
					<h2>DISEÑADO <br /> PARA <em>CRECER</em></h2>
				</div>
				<div class="objetivo-content" data-reveal data-delay="1">
					<p>
						Diseñado para pequeñas y medianas empresas que buscan
						mantener una <em>presencia activa en redes</em>. Incluye contenido
						grabado con celular para un estilo más <em>cercano y dinámico</em>,
						combinado con fotos en cámara profesional, garantizando el
						equilibrio perfecto.
					</p>
				</div>
				<div class="objetivo-cards" data-reveal data-delay="2">
					<div class="objetivo-card oc1">
						<h3>Contenido Orgánico</h3>
						<p>
							Contenido natural, de calidad y con enfoque profesional.
						</p>
					</div>
					<div class="objetivo-card oc2">
						<h3>Banco de imágenes</h3>
						<p>
							Imágenes para tu marca que construyen una identidad visual sólida.
						</p>
					</div>
					<div class="objetivo-card oc3">
						<h3>Contenido con creadores</h3>
						<p>
							Recomendaciones reales para aumentar confianza y alcance. 
						</p>
					</div>
				</div>
			</div>
			<video controls autoplay muted loop playsinline width="640">
				<source src="/objetivo.mp4" type="video/mp4" />
				Tu navegador no soporta videos.
			</video>
		</div>
		
	</section>

	<section class="paquetes">
		<div class="paquetes-header" data-reveal>
			<div class="chip light">PLANES</div>
			<h2>ELIGE TU <em>PLAN</em></h2>
		</div>
		<div class="filter" data-reveal data-delay="1">
			<button class="filter-btn active" data-filter="fotografico">Fotográfico</button>
			<button class="filter-btn" data-filter="video">Video</button>
			<button class="filter-btn" data-filter="social">Social Media</button>
		</div>

		<div class="paquetes-container" data-reveal data-delay="2">
			{todosLosPaquetes.map((paquete) => (
				<PaqueteCard 
					title={paquete.titulo} 
					description={paquete.descripcion.split(".").filter((item) => item.trim() !== "")} 
					price={paquete.precio} 
					video={paquete.video || ""} 
					categoria={paquete.categoria}
				/>
			))}
		</div>
	</section>

	

	<section class="portafolio" id="portafolio">
		<div class="portafolio-container">
			<div class="portafolio-header" data-reveal>
				<div class="chip dark">PORTAFOLIO</div>
				<h2>NUESTRO <em>TRABAJO</em></h2>
			</div>
			
			<div class="portafolio-carousel-wrapper" data-reveal data-delay="1">
				<button class="carousel-btn carousel-prev" id="prevBtn" aria-label="Anterior">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
				</button>

				<div class="portafolio-gallery" id="portfolioGallery">
					<div class="gallery-img g-left">
						<img id="imgLeft" src="/p7.jpg" alt="Portafolio" />
					</div>
					<div class="gallery-img g-center">
						<img id="imgCenter" src="/p1.jpg" alt="Portafolio" />
					</div>
					<div class="gallery-img g-right">
						<img id="imgRight" src="/p2.jpg" alt="Portafolio" />
					</div>
				</div>

				<button class="carousel-btn carousel-next" id="nextBtn" aria-label="Siguiente">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
				</button>
			</div>

			<div class="carousel-dots" id="carouselDots"></div>

			<a href="#" class="btn-primary ver-completo">Ver Portafolio completo</a>
		</div>

		<div class="marquesina-container">
			<div class="marquesina">
				<div class="marquesina-track">
					<div class="logo-slide"><img src="/logo1.png" alt="Logo 1"></div>
					<div class="logo-slide"><img src="/logo2.png" alt="Logo 2"></div>
					<div class="logo-slide"><img src="/logo3.png" alt="Logo 3"></div>
					<div class="logo-slide"><img src="/logo4.png" alt="Logo 4"></div>
					<div class="logo-slide"><img src="/logo5.png" alt="Logo 5"></div>
					<div class="logo-slide"><img src="/logo6.png" alt="Logo 6"></div>
					<div class="logo-slide"><img src="/logo7.png" alt="Logo 7"></div>
					<div class="logo-slide"><img src="/logo8.png" alt="Logo 8"></div>
					<div class="logo-slide"><img src="/logo9.png" alt="Logo 9"></div>
					<!-- duplicado para loop infinito -->
					<div class="logo-slide"><img src="/logo1.png" alt="Logo 1"></div>
					<div class="logo-slide"><img src="/logo2.png" alt="Logo 2"></div>
					<div class="logo-slide"><img src="/logo3.png" alt="Logo 3"></div>
					<div class="logo-slide"><img src="/logo4.png" alt="Logo 4"></div>
					<div class="logo-slide"><img src="/logo5.png" alt="Logo 5"></div>
					<div class="logo-slide"><img src="/logo6.png" alt="Logo 6"></div>
					<div class="logo-slide"><img src="/logo7.png" alt="Logo 7"></div>
					<div class="logo-slide"><img src="/logo8.png" alt="Logo 8"></div>
					<div class="logo-slide"><img src="/logo9.png" alt="Logo 9"></div>
				</div>
			</div>
		</div>
	</section>

	<section class="razones" id="razones">
		<div class="razones-inner">

			<div class="razones-left" data-reveal="scale">
				
				<div class="razones-img-wrapper">
					<img src="/p2.jpg" alt="Nuestro trabajo" />
					<div class="razones-badge">
						<span class="badge-num">+100</span>
						<span class="badge-label">Clientes satisfechos</span>
					</div>
				</div>
			</div>

			<div class="razones-right">
				<div class="razones-right-header" data-reveal>
					<div class="chip dark">TUS BENEFICIOS</div>
					<h2>RAZONES <br /> PARA <em>ELEGIRNOS</em></h2>
				</div>

				<div class="razon-item" data-reveal data-delay="1">
					<span class="razon-num rn1">01</span>
					<div class="razon-body">
						<h3>Descuentos Exclusivos</h3>
						<p>Amamos las relaciones largas. Tu compromiso se traduce en beneficios reales.</p>
						<div class="discount-tags">
							<span class="dtag">5% × 3 meses</span>
							<span class="dtag">10% × 6 meses</span>
							<span class="dtag">15% × 12 meses</span>
						</div>
					</div>
				</div>

				<div class="razon-divider"></div>

				<div class="razon-item" data-reveal data-delay="2">
					<span class="razon-num rn2">02</span>
					<div class="razon-body">
						<h3>Modelos</h3>
						<p>Humanizamos tu contenido para conectar mejor con tu audiencia. Cada sesión incluye 2 modelos.</p>
					</div>
				</div>

				<div class="razon-divider"></div>

				<div class="razon-item" data-reveal data-delay="3">
					<span class="razon-num rn3">03</span>
					<div class="razon-body">
						<h3>Colaboraciones</h3>
						<p>Potenciamos tu alcance con creadores de contenido en reels, historias y posts estratégicos.</p>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- CONTACTO -->
	<section class="contacto" id="contacto">
		<div class="contacto-card" data-reveal="scale">

			<div class="contacto-info">
				<div class="contacto-header">
					<div class="chip light">CONTACTO</div>
					<h2>HABLEMOS DE <br /> TU <em>PROYECTO</em></h2>
				</div>

				<div class="contacto-items">
					<a href="https://wa.me/59162161541" target="_blank" class="contacto-item">
						<div class="citem-icon">
