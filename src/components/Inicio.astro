	}

	.persona-img:hover {
		transform: scale(1.04);
	}

	.persona-card {
		position: absolute;
		bottom: 16px;
		right: 0;
		background-color: var(--accent);
		border-radius: 16px;
		padding: 14px 20px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 180px;
	}

	.persona-nombre {
		font-family: var(--font-montserrat);
		font-size: 15px;
		font-weight: 800;
		color: var(--white);
	}

	.persona-rol {
		font-family: var(--font-hind);
		font-size: 12px;
		color: rgba(255,255,255,0.8);
	}

	@media (max-width: 900px) {
		.contacto-card {
			padding-right: 24px;
		}

		.contacto-info{
			padding: 24px;
		}
		.contacto-persona {
			align-self: center;
		}

		.persona-img {
			height: 380px;
		}
	}

	@media (max-width: 480px) {
		.contacto {
			padding: 60px 24px;
		}

		
		.contacto-card {
			flex-direction: column;
			align-items: flex-start;
			min-height: auto;
			gap: 0px;
			padding-bottom: 0px ;
		}

		.contacto-info h2 {
			font-size: clamp(24px, 8vw, 36px);
		}

		.persona-img {
			height: 100vw;
		}

		.persona-card {
			min-width: 150px;
		}
