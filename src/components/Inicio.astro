	/* ── Razones ── */
	.razones {
		width: 100%;
		background-color: var(--white);
		padding: 100px 0;
	}

	.razones-inner {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
		display: flex;
		flex-direction: row;
		gap: 64px;
		align-items: center;
	}

	/* Columna izquierda */
	.razones-left {
		flex: 0 0 360px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.razones-img-wrapper {
		position: relative;
		border-radius: 28px;
		overflow: hidden;
		aspect-ratio: 3/4;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
	}

	.razones-img-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.razones-img-wrapper:hover img {
		transform: scale(1.04);
		
	}

	.razones-badge {
		position: absolute;
		bottom: 20px;
		left: 20px;
		background: var(--white);
		border-radius: 16px;
		padding: 14px 20px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
	}

	.badge-num {
		font-family: var(--font-montserrat);
		font-size: 28px;
		font-weight: 900;
		color: var(--violet);
		line-height: 1;
	}

	.badge-label {
		font-family: var(--font-hind);
		font-size: 12px;
		font-weight: 600;
		color: var(--black);
	}

	/* Columna derecha */
	.razones-right {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.razones-right h2 {
		color: var(--accent);
		line-height: 1.1;
		padding: 10px 0 40px;
	}

	.razones-right h2 em {
		color: var(--violet);
		font-style: normal;
	}

	.razon-item {
		display: flex;
		flex-direction: row;
		gap: 28px;
		align-items: flex-start;
		padding: 28px 0;
	}

	.razon-num {
		font-family: var(--font-montserrat);
		font-size: clamp(32px, 4vw, 48px);
		font-weight: 900;
		line-height: 1;
		flex-shrink: 0;
		width: 64px;
	}

	.rn1 { color: var(--violet); }
	.rn2 { color: var(--accent); }
	.rn3 { color: var(--light-violet); }

	.razon-body h3 {
		font-family: var(--font-montserrat);
		font-size: clamp(16px, 2vw, 20px);
		font-weight: 800;
		color: var(--black);
		margin-bottom: 8px;
	}

	.razon-body p {
		font-family: var(--font-hind);
		font-size: clamp(14px, 1.4vw, 15px);
		color: #666;
		line-height: 1.6;
	}

	.razon-divider {
		width: 100%;
		height: 1px;
		background-color: #e8e8e8;
	}

	.discount-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 14px;
	}

	.dtag {
		background-color: var(--secondary);
		color: var(--violet);
		font-family: var(--font-montserrat);
		font-size: 12px;
		font-weight: 700;
		padding: 5px 14px;
		border-radius: 20px;
	}

	@media (max-width: 1024px) {
		.razones-left {
			flex: 0 0 300px;
		}

		.razones-inner {
			gap: 40px;
		}
	}

	@media (max-width: 768px) {
		.razones {
			padding: 60px 0;
		}

		.razones-inner {
			flex-direction: column;
			gap: 40px;
		}

		.razones-left {
			flex: none;
			width: 100%;
			max-width: 400px;
			align-self: center;
		}

		.razones-img-wrapper {
			aspect-ratio: 4/3;
		}
	}

	@media (max-width: 480px) {
		.razones-img-wrapper {
			aspect-ratio: 16/9;
		}

		.razon-num {
			width: 48px;
			font-size: 28px;
		}

		.razon-item {
			gap: 16px;
			padding: 20px 0;
		}

		.discount-tags {
			gap: 6px;
		}
	}

	/* ── Contacto ── */
	.contacto {
		width: 100%;
		background-color: var(--white);
		padding: 80px 24px;
		display: flex;
		justify-content: center;
	}

	.contacto-card {
		width: 100%;
		max-width: 1100px;
		background-color: var(--primary);
		border-radius: 32px;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		overflow: hidden;
		position: relative;
		min-height: 380px;
		padding-right: 60px;
