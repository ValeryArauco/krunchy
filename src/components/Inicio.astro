		width: 100%;
		overflow: hidden;
		white-space: nowrap;
		position: relative;
	}
	
	.marquesina-track {
		display: inline-flex;
		align-items: center;
		animation: scroll 20s linear infinite;
	}

	.marquesina-track:hover {
		animation-play-state: paused;
	}
	
	

	.logo-slide {
		width: 80px;
		height: 80px;
		margin: 0 24px;
		border-radius: 50%;
