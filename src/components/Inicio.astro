<script
	src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
	is:inline></script>
<script
	src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
	is:inline></script>
<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		gsap.registerPlugin(ScrollTrigger);

		const sc1 = document.querySelector(".sc1");
		const sc2 = document.querySelector(".sc2");
		const sc3 = document.querySelector(".sc3");

		if (!sc1 || !sc2 || !sc3) return;

		let mm = gsap.matchMedia();

		mm.add("(min-width: 481px)", () => {
			const getXOffset = (target) =>
				sc2.getBoundingClientRect().left -
				target.getBoundingClientRect().left;

			gsap.set(".sc1", { x: () => getXOffset(sc1) });
			gsap.set(".sc3", { x: () => getXOffset(sc3) });

			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: ".servicios",
					start: "top 45%",
					end: "bottom 95%",
					scrub: 0.05,
				},
			});

			tl.to(".sc1", { x: 0, duration: 2, ease: "power2.out" }, "spread")
			  .to(".sc3", { x: 0, duration: 2, ease: "power2.out" }, "spread");

			let timeout;
			const resizeHandler = () => {
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					// Restaurar a posicion base antes de medir para no arruinar el offset en un refresh intermedio
					gsap.set([".sc1", ".sc3"], { x: 0 });
					gsap.set(".sc1", { x: () => getXOffset(sc1) });
					gsap.set(".sc3", { x: () => getXOffset(sc3) });
					ScrollTrigger.refresh();
				}, 200);
			};
			window.addEventListener("resize", resizeHandler);
			return () => window.removeEventListener("resize", resizeHandler);
		});

		mm.add("(max-width: 480px)", () => {
			const getYOffset = (target) =>
				sc1.getBoundingClientRect().top -
				target.getBoundingClientRect().top;

			gsap.set(".sc2", { y: () => getYOffset(sc2) });
			gsap.set(".sc3", { y: () => getYOffset(sc3) });

			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: ".servicios",
					start: "top 30%",
					end: "bottom 100%",
					scrub: 0.05,
				},
			});

			tl.to(".sc2", { y: 30, duration: 2, ease: "power2.out" }, "spread")
			  .to(".sc3", { y: 50, duration: 2, ease: "power2.out" }, "spread");

			let timeout;
			const resizeHandler = () => {
				clearTimeout(timeout);
				timeout = setTimeout(() => {
					gsap.set([".sc2", ".sc3"], { y: 0 });
					gsap.set(".sc2", { y: () => getYOffset(sc2) });
					gsap.set(".sc3", { y: () => getYOffset(sc3) });
					ScrollTrigger.refresh();
				}, 200);
			};
			window.addEventListener("resize", resizeHandler);
			return () => window.removeEventListener("resize", resizeHandler);
		});

		// Filtros de paquetes
		const filterBtns = document.querySelectorAll('.filter-btn');
		const packageCards = document.querySelectorAll('.paquete-card');

		// Mostrar por defecto solo la categoria del boton activo al cargar
		const activeBtn = document.querySelector('.filter-btn.active');
		if (activeBtn) {
			const activeFilter = activeBtn.getAttribute('data-filter');
			packageCards.forEach(card => {
				if (card.getAttribute('data-category') === activeFilter) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		}

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				filterBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');

				const filterValue = btn.getAttribute('data-filter');

				packageCards.forEach(card => {
					if (card.getAttribute('data-category') === filterValue) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			});
		});
	});
</script>

