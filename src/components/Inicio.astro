		color: var(--white);
		font-size: clamp(28px, 4vw, 52px);
		line-height: 1.1;
		padding: 10px 0 0;
	}

	.contacto-header h2 em {
		color: var(--light-accent);
		font-style: normal;
	}

	.contacto-items {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.contacto-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 16px;
		transition: transform 0.25s var(--ease-spring);
	}

	.contacto-item:hover {
		transform: translateX(6px) rotate(0deg);
	}

	.citem-icon {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background-color: rgba(255,255,255,0.2);
		display: flex;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
		color: var(--white);
	}

	.citem-icon svg {
		width: 20px;
		height: 20px;
	}

	.citem-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.citem-label {
		font-family: var(--font-montserrat);
