<style>


	main {
		overflow-x: hidden; /* Evita que el giro muestre barra de desplazamiento horizontal */
		background-color: var(--primary);
	}

	.hero {
		width: 100%;
		height: 110vh;
		background-image: url(/banner.webp);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		position: relative;
		z-index: 10;
		animation: drop-photo 1.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)
			forwards;
		transform-origin: center;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		z-index: -1;
	}

	.hero::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url(/banner2.webp);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 0;
		z-index: -2;
		animation: fade-banner2 8s ease-in-out infinite;
	}

	.hero::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url(/banner3.webp);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 0;
		z-index: -2;
		animation: fade-banner3 8s ease-in-out infinite;
	}

	@keyframes fade-banner2 {
		0%,
		28% {
			opacity: 0;
		}
		33%,
		67% {
			opacity: 1;
		}
		72%,
		100% {
			opacity: 0;
		}
	}

	@keyframes fade-banner3 {
		0%,
		61% {
			opacity: 0;
		}
		67%,
		94% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	@keyframes drop-photo {
		0% {
			opacity: 0;
			transform: scale(1.4) translateY(-100px) rotate(-4deg);
			filter: blur(10px) brightness(1.3);
		}
		100% {
			opacity: 1;
			transform: scale(1) translateY(0) rotate(0deg);
			filter: blur(0px) brightness(1);
		}
	}
	.hero-logo {
		width: auto;
		height: 60px;
		margin: 0px;
		padding: 0px;
	}

	.hero-shape {
		width: 100%;
		height: 30vh;
		background: var(--primary);
		position: absolute;
		bottom: 0;
		right: 0;
		clip-path: polygon(0 0, 0 100%, 100% 100%);
		margin-bottom: -1px;
	}

	.card {
		width: 100%;
		height: 100%;
		background: transparent;
		padding: 40px;
