		flex-direction: column;
		gap: 10px;
	}

	.footer-contact-list span {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-hind);
		font-size: 14px;
		color: rgba(255,255,255,0.6);
