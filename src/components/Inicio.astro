		justify-content: center;
		align-items: center;
		overflow: hidden;
		flex-shrink: 0;
		box-shadow: 0 4px 10px rgba(0,0,0,0.08);
		
	}

	.logo-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover !important;
	}

	.logo-slide:nth-child(9),
	.logo-slide:nth-child(18) {
		background-color: #CC2E29 !important;
		padding: 10px;
	}

	.logo-slide:nth-child(9) img,
	.logo-slide:nth-child(18) img {
		object-fit: contain !important;
	}
	@keyframes scroll {
