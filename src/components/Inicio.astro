---
import PaqueteCard from './PaqueteCard.astro';
import planesData from '../../public/krunchy_planes.json';

const todosLosPaquetes = [
	...planesData.planes.paquetes_fotograficos.map(p => ({...p, categoria: 'fotografico'})),
	...planesData.planes.paquetes_video_publicitario.map(p => ({...p, categoria: 'video'})),
	...planesData.planes.paquetes_social_media.map(p => ({...p, categoria: 'social'}))
];
---

