---
interface Props {
	video: string;
	title: string;
	description: string[];
	price: string;
	categoria: string;
}

const { title, description, video, price, categoria } = Astro.props;

const whatsappLink = `https://wa.me/59162161541?text=${encodeURIComponent(
  `Hola, me interesa contratar el plan ${title}`
)}`;

---

<div class="paquete-card" data-category={categoria}>
	{video && (
		<video controls autoplay muted loop playsinline width="640">
			<source src={video} type="video/mp4" />
			Tu navegador no soporta videos.
		</video>
	)}
	<div class="paquete-card-content">
		<h3>{title}</h3>
		<ul>
			{description.map((item) => <li>{item}</li>)}
		</ul>
		<div class="p-container">
			<p class="price">{price}</p>
			<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-primary">Elegir</a>
		</div>
	</div>
</div>

<style>
	.paquete-card {
		background-color: var(--white);
		border-radius: 16px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 100%;
		max-width: 320px;
		height: 100%;
	}

	.paquete-card-content{
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.paquete-card video {
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 12px;
		background-image: url(/logo.png);
	}

	.paquete-card-content h3 {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--violet);
		margin: 0;
	}

	.paquete-card-content ul{
		font-size: 0.95rem;
		color: var(--black);
		line-height: 1.5;
		padding-bottom: 15px;
		padding-top: 15px;
		flex: 1;
		
	}

	.paquete-card-content li{
		margin-left: 15px;
		font-size: 0.95rem;
		color: var(--black);
		line-height: 1.5;
	}
	.p-container{
		display: flex;
		justify-content: space-between;
		align-items: left;
		flex-direction: column;
	}

	.paquete-card-content .price {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--black);
		margin-top: 4px;
	}

	.paquete-card-content .btn-primary {
		background: var(--violet);
		color: var(--white);
		padding: 10px 20px;
		border-radius: 30px;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
		transition: all 0.3s ease;
		margin-top: 8px;
	}

	.paquete-card-content .btn-primary:hover {
		transform: scale(1.05) rotate(3deg);
		color: var(--white);
	}

	.paquete-card-content .btn-primary:active {
		transform: scale(1.05) rotate(3deg);
		color: var(--white);
	}

	@media (max-width: 576px) {
		.paquete-card {
			max-width: 100%;
			display: flex;
			flex-direction: row;
			gap: 20px;
			
		}
		.paquete-card video {
			flex: 0 0 150px;
			width: 150px;
			height: 170px;
			object-fit: cover;

			background-image: url(/logo.png);
		}

		.paquete-card-content {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}	

		.paquete-card-content ul{
			padding: 0;
		}

		.paquete-card-content .price{
			line-height: 1;
		}
		.p-container{
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
			width: 100%;
		}

	}
</style>
