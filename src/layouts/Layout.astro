
---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>



		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="krunchy" />
		<link rel="manifest" href="/site.webmanifest" />


		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@300;400;500;600;700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	</head>
	<body>
		<Header />
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primary: #8198ca;
		--secondary: #d9d8d8;
		--accent: #85b4db;
		--dark-accent: #2a608e;
		--light-accent: #c4dbee;
		--white: #ffffff;
		--black: #2c2c2c;
		--violet: #5b68c9;
		--dark-violet: #2a2682;
		--light-violet: #9da4df;
		--dark-light-violet: #757ed2;

		--font-hind: "Hind Madurai", sans-serif;
		--font-montserrat: "Montserrat", sans-serif;

		/* Animation easing */
		--ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		--ease-pop:    cubic-bezier(0.175, 0.885, 0.32, 1.275);
		--ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);

		/* Spacing */
		--section-py: clamp(64px, 8vw, 120px);
		--container-px: clamp(16px, 3vw, 24px);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		font-family: var(--font-montserrat);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
